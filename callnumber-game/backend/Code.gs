const SHEET_NAME='scores';
function setup(){const p=PropertiesService.getScriptProperties();let id=p.getProperty('SHEET_ID');if(!id){const ss=SpreadsheetApp.create('청구기호 서가정렬 훈련 점수');id=ss.getId();p.setProperty('SHEET_ID',id);const sh=ss.getSheets()[0];sh.setName(SHEET_NAME);sh.getRange(1,1,1,12).setValues([['timestamp','student','studentNo','mode','score','exact','inversions','hints','seconds','perfect','sessionId','userAgent']]);sh.setFrozenRows(1)}let key=p.getProperty('ADMIN_KEY');if(!key){key=Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'').slice(0,12);p.setProperty('ADMIN_KEY',key)}console.log('ADMIN KEY: '+key);console.log('SHEET: https://docs.google.com/spreadsheets/d/'+id)}
function doPost(e){try{const p=e.parameter||{};if((p.action||'save')!=='save')return j({ok:false,error:'invalid action'});const student=c(p.student,30);if(!student)return j({ok:false,error:'student required'});sheet().appendRow([new Date(),student,c(p.studentNo,30),n(p.mode),n(p.score),n(p.exact),n(p.inversions),n(p.hints),n(p.seconds),c(p.perfect,3),c(p.sessionId,100),c(p.userAgent,180)]);return j({ok:true})}catch(err){return j({ok:false,error:String(err)})}}
function doGet(e){const p=e.parameter||{};if(p.action==='list'){const cb=String(p.callback||'').replace(/[^\w.$]/g,''),key=String(p.key||''),expect=PropertiesService.getScriptProperties().getProperty('ADMIN_KEY')||'',out=(key&&key===expect)?list():{ok:false,error:'관리자 키가 올바르지 않습니다.'};return cb?js(cb+'('+JSON.stringify(out)+');'):j(out)}return j({ok:true,service:'callnumber-score-api'})}
function list(){const v=sheet().getDataRange().getValues();if(v.length<2)return {ok:true,rows:[]};const h=v[0].map(String),rows=v.slice(1).map(r=>{const o={};h.forEach((k,i)=>o[k]=(k==='timestamp'&&r[i] instanceof Date)?Utilities.formatDate(r[i],Session.getScriptTimeZone()||'Asia/Seoul','yyyy-MM-dd HH:mm:ss'):r[i]);return o}).reverse();return {ok:true,rows}}
function sheet(){const id=PropertiesService.getScriptProperties().getProperty('SHEET_ID');if(!id)throw new Error('setup()을 먼저 실행하세요.');const ss=SpreadsheetApp.openById(id);return ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME)}
function c(v,m){return String(v==null?'':v).replace(/[<>]/g,'').trim().slice(0,m)}function n(v){const x=Number(v);return Number.isFinite(x)?x:0}function j(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}function js(s){return ContentService.createTextOutput(s).setMimeType(ContentService.MimeType.JAVASCRIPT)}